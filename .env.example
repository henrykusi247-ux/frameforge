# Environment example for FrameForge

# JWT secret used to sign auth tokens (keep secret in production)
JWT_SECRET=replace-with-a-secure-secret

# Optionally set a DATABASE_URL to use Postgres instead of the local JSON file
#DATABASE_URL=postgres://user:pass@host:5432/dbname

# AI provider key (used by server/ai-client.js when integrated)
#AI_API_KEY=your_ai_provider_key

# Render / deployment hooks (optional)
#RENDER_API_KEY=
#RENDER_SERVICE_ID=

# Environment example for FrameForge

# JWT secret used to sign local auth tokens (keep secret in production)
JWT_SECRET=replace-with-a-secure-secret

# Supabase project credentials (production-ready auth/storage/db integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Postgres connection string if you decide to use direct Postgres instead of Supabase
#DATABASE_URL=postgres://user:pass@host:5432/frameforge

# AI provider key (used when integrating a real generation provider)
#AI_API_KEY=your_ai_provider_key
